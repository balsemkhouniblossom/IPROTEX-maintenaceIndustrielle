    +type_maintenance: String?
    +status: String
    +priorite: String?
    +code_panne: String?
    +date_created: Date
    +date_start: Date?
    +scheduled_date: Date?
    +due_date: Date?
    +execution_date: Date?
    +date_end: Date?
    +date_closed: Date?
    +recurrence_source_occurrence_id: ObjectId? <<FK WorkOrder>>
