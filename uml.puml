@startuml
title GMAO Industrielle - Diagramme de classes detaille (implementation reelle)

hide empty members
hide circle
left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

' =============================
' ENUMERATIONS
' =============================
enum Role {
  admin
  technician
  operator
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum MaintenancePlanStatus {
  draft
  active
  paused
  archived
  completed
}

enum PartRequestStatus {
  pending
  reserved
  fulfilled
  cancelled
}

enum StockMovementType {
  reservation
  consumption
  return
  adjustment
  cancellation
}

enum NotificationType {
  work_order_created
  preventive_due
  preventive_overdue
  overdue_escalation
  corrective_awaiting_validation
  validation_approved
  validation_rejected
  intervention_completed
  part_request_created
  part_request_decision
  stock_alert
  lubrication_due
  sensor_alert
  duplicate_work_order
  device_fault
  device_offline
  report_ready
}

enum DocumentStatus {
  draft
  published
  archived
  superseded
}

enum KnowledgeArticleCategory {
  troubleshooting
  procedure
  fault_code
  lubrication
  safety
}

enum KnowledgeArticleStatus {
  draft
  published
  archived
}

enum DeviceType {
  openplc
  simulator
  gateway
}

enum DeviceConnectionStatus {
  unknown
  online
  offline
}

enum FaultEventSeverity {
  info
  warning
  critical
}

enum PredictionModelType {
  zscore
  isolation_forest
  dbscan
  autoencoder
}

enum PredictionModelVersionStatus {
  active
  archived
}

enum PredictionRiskLevel {
  low
  medium
  high
  critical
  insufficient_data
}

enum AiInteractionStatus {
  ok
  disabled
  missing_configuration
  invalid_credentials
  quota_limited
  temporary_failure
  rate_limited
  timeout
  error
}

enum ReportType {
  machine_history
  preventive_compliance
  corrective_downtime
  mttr_mtbf_trends
  stock_movements
  maintenance_costs
  technician_workload
  fault_frequency
  audit_history
  predictive_risk
}

enum ReportFormat {
  pdf
  excel
  csv
}

enum ReportStatus {
  pending
  processing
  completed
  failed
}

enum ScheduleFrequency {
  daily
  weekly
  monthly
}

' =============================
' IDENTITE, ACCES & AUTHENTIFICATION
' =============================
package "Identite, acces & authentification" {
  class User {
    +_id: ObjectId <<PK>>
    +user_id: String <<UK>>
    +nom_complet: String
    +email: String <<UK>>
    +password: String? <<sensitive>>
    +google_id: String? <<UK,sparse,sensitive>>
    +google_linked_at: Date?
    +google_unlinked_at: Date?
    +refresh_token_hash: String? <<sensitive>>
    +reset_password_token: String? <<sensitive>>
    +reset_password_expires: Date?
    +must_reset_password: Boolean?
    +credentials_invalidated_at: Date?
    +role: Role
    +is_active: Boolean
    +last_login: Date?
    +login_history: Date[]
    +created_at: Date
    +phone: String?
    +department: String?
    +position: String?
    +language: String?
    +profile_completed: Boolean
    +photo: String?
    +photo_storage_path: String?
    +photo_url: String?
    +assigned_machine_ids: ObjectId[] <<FK Machine>>
    +is_verified: Boolean
    +approval_status: ApprovalStatus?
    +approved_by: ObjectId? <<FK User>>
    +approved_at: Date?
    +rejected_by: ObjectId? <<FK User>>
    +rejected_at: Date?
    +rejection_reason: String?
    +google_auth_history: GoogleAuthHistoryEntry[]
    +approval_history: ApprovalHistoryEntry[]
  }

  class GoogleAuthHistoryEntry {
    +action: String {linked|unlinked|relinked}
    +google_id: String?
    +previous_google_id: String?
    +actor_user_id: ObjectId? <<FK User>>
    +at: Date
  }

  class ApprovalHistoryEntry {
    +status: ApprovalStatus
    +actor_user_id: ObjectId? <<FK User>>
    +reason: String?
    +at: Date
  }

  class GoogleLoginExchange {
    +_id: ObjectId <<PK>>
    +code_hash: String <<UK>>
    +encrypted_payload: String
    +encryption_iv: String
    +encryption_tag: String
    +created_at: Date
    +expires_at: Date <<TTL>>
  }

  class Counter {
    +_id: String <<PK>>
    +seq: Number
  }
}

' =============================
' ACTIFS INDUSTRIELS
' =============================
package "Actifs industriels" {
  class MachineType {
    +_id: ObjectId <<PK>>
    +type_id: Number <<UK>>
    +name: String
    +description: String?
    +createdAt: Date
    +updatedAt: Date
  }

  class Machine {
    +_id: ObjectId <<PK>>
    +machine_id: String <<UK>>
    +type_id: ObjectId <<FK MachineType>>
    +serial_no: String
    +reference: String?
    +installation_date: Date?
    +poids_kg: Number?
    +fabricant: String?
    +model: String?
    +location: String?
    +status: String
    +lifecycle_history: MachineLifecycleEntry[]
    +createdAt: Date
    +updatedAt: Date
  }

  class MachineLifecycleEntry {
    +action: String {created|status_changed}
    +from_status: String?
    +to_status: String
    +actor_user_id: ObjectId? <<FK User>>
    +reason: String?
    +at: Date
  }

  class ModuleType {
    +_id: ObjectId <<PK>>
    +mod_type_id: String <<UK>>
    +type_id: ObjectId <<FK MachineType>>
    +nom_module: String
    +categorie_module: String?
  }

  class Module {
    +_id: ObjectId <<PK>>
    +module_id: String <<UK>>
    +machine_id: ObjectId <<FK Machine>>
    +mod_type_id: ObjectId <<FK ModuleType>>
    +parent_module_id: ObjectId? <<FK Module>>
    +localisation: String?
    +createdAt: Date
    +updatedAt: Date
  }

  class Capteur {
    +_id: ObjectId <<PK>>
    +capteur_id: String <<UK>>
    +module_id: ObjectId <<FK Module>>
    +code_capteur: String
    +type_capteur: String
    +unite_mesure: String?
    +mqtt_topic: String?
    +seuil_avertissement: Number?
    +seuil_critique: Number?
    +frequence_echantillonnage: Number?
    +is_active: Boolean
    +last_seen_at: Date?
    +firmware_version: String?
  }

  class Mesure {
    +_id: ObjectId <<PK>>
    +mesure_id: String <<UK>>
    +capteur_id: ObjectId <<FK Capteur>>
    +valeur: Number
    +timestamp: Date
    +status: String
    +createdAt: Date
    +updatedAt: Date
  }
}

' =============================
' MAINTENANCE, PLANS, OT & INTERVENTIONS
' =============================
package "Maintenance, plans, OT & interventions" {
  class MaintenancePlan {
    +_id: ObjectId <<PK>>
    +plan_id: String <<UK>>
