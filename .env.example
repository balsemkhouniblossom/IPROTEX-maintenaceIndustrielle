# GMAO Environment Configuration Template
#
# This file is tracked documentation only. Do not put real secrets, real service
# role keys, real SMTP passwords, or real OAuth client secrets here.

# =============================================================================
# Local Development
# =============================================================================

# Backend local .env example
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
MONGODB_URI=mongodb://localhost:27017/GMAO_IPROTEX

JWT_SECRET=<local-strong-random-secret>
JWT_REFRESH_SECRET=<local-strong-random-refresh-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_VERIFICATION_SECRET=<local-strong-random-email-verification-secret>
GOOGLE_LOGIN_EXCHANGE_ENCRYPTION_KEY=<local-32-byte-base64-or-32-character-key>

GOOGLE_CLIENT_ID=<local-google-client-id>
GOOGLE_CLIENT_SECRET=<local-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

BACKEND_URL=http://localhost:3001
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

FILE_STORAGE_DRIVER=local

SMTP_HOST=<local-smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<local-smtp-user>
SMTP_PASS=<local-smtp-password>
SMTP_REJECT_UNAUTHORIZED=true
EMAIL_FROM="GMAO <noreply@example.local>"
EMAIL_DELIVERY_MODE=auto
SMTP_VERIFY_ON_STARTUP=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_FALLBACK_COOLDOWN_MS=300000
BREVO_API_KEY=<optional-local-brevo-api-key>
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_TIMEOUT_MS=10000

ENABLE_LEGACY_EMAIL_TOKENS=false
ENABLE_LEGACY_RESET_TOKENS=false
LEGACY_AUTH_MIGRATION_DEADLINE=
ENABLE_EVENT_BASED_EMAILS=false
ENABLE_EMAIL_DIAGNOSTIC_TEST=false
EMAIL_DIAGNOSTIC_RECIPIENT=
FORGOT_PASSWORD_ASYNC_EMAIL=false
DEFAULT_LOCALE=en

# AI Assistant (backend only, advisory only)
# Keep disabled unless a backend Gemini key is configured. Never expose
# GEMINI_API_KEY to frontend/Vercel variables.
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=your_real_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
AI_ASSISTANT_TIMEOUT_MS=12000
AI_ASSISTANT_RATE_LIMIT_PER_HOUR=20

# Frontend local frontend/.env.local example
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# =============================================================================
# Render Backend Production Variables
# =============================================================================
#
# Configure these only in Render backend environment/secrets. Do not copy backend
# secrets into Vercel.

NODE_ENV=production
PORT=<render-port-or-10000>
MONGODB_URI=<mongodb-atlas-uri>
MONGODB_REQUIRE_ATLAS=true

JWT_SECRET=<production-strong-random-secret>
JWT_REFRESH_SECRET=<production-strong-random-refresh-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_VERIFICATION_SECRET=<production-strong-random-email-verification-secret>
GOOGLE_LOGIN_EXCHANGE_ENCRYPTION_KEY=<production-32-byte-base64-or-32-character-key>

GOOGLE_CLIENT_ID=<production-google-client-id>
GOOGLE_CLIENT_SECRET=<production-google-client-secret>
GOOGLE_CALLBACK_URL=https://pfe-maintenaceindustrielle.onrender.com/auth/google/callback

BACKEND_URL=https://pfe-maintenaceindustrielle.onrender.com
API_URL=https://pfe-maintenaceindustrielle.onrender.com
FRONTEND_BASE_URL=https://pfe-maintenace-industrielle.vercel.app
APP_URL=https://pfe-maintenace-industrielle.vercel.app
TRUST_PROXY=true
# Production CORS must be exact HTTPS origins. Wildcards and localhost are rejected.
CORS_ORIGINS=https://pfe-maintenace-industrielle.vercel.app

# Production storage must be private Supabase storage so uploads survive deploys.
FILE_STORAGE_DRIVER=supabase
SUPABASE_URL=https://<supabase-project-ref>.supabase.co
SUPABASE_SECRET_KEY=<supabase-service-role-secret>
SUPABASE_STORAGE_BUCKET=<supabase-storage-bucket>
SUPABASE_STORAGE_BUCKET_PUBLIC=false
SUPABASE_SIGNED_URL_EXPIRES_IN_SECONDS=604800

SMTP_HOST=<production-smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<production-smtp-user>
SMTP_PASS=<production-smtp-password>
SMTP_REJECT_UNAUTHORIZED=true
EMAIL_FROM="GMAO <noreply@example.com>"
EMAIL_DELIVERY_MODE=auto
SMTP_VERIFY_ON_STARTUP=false
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_FALLBACK_COOLDOWN_MS=300000
BREVO_API_KEY=<optional-production-brevo-api-key>
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_TIMEOUT_MS=10000
FORGOT_PASSWORD_ASYNC_EMAIL=true

# Keep disabled in production unless an approved temporary migration is active.
ENABLE_LEGACY_EMAIL_TOKENS=false
ENABLE_LEGACY_RESET_TOKENS=false
LEGACY_AUTH_MIGRATION_DEADLINE=
ENABLE_EVENT_BASED_EMAILS=false

# Keep disabled unless temporarily enabling the restricted Admin diagnostic.
ENABLE_EMAIL_DIAGNOSTIC_TEST=false
EMAIL_DIAGNOSTIC_RECIPIENT=

DEFAULT_LOCALE=en

# AI Assistant (backend only, advisory only)
# Keep disabled unless a backend Gemini key is configured. Never expose
# GEMINI_API_KEY to frontend/Vercel variables.
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_PROVIDER=gemini
GEMINI_API_KEY=your_real_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
AI_ASSISTANT_TIMEOUT_MS=12000
AI_ASSISTANT_RATE_LIMIT_PER_HOUR=20

# =============================================================================
# Vercel Frontend Production Variables
# =============================================================================
#
# Configure only public frontend variables in Vercel. Never configure
# SUPABASE_SECRET_KEY, JWT secrets, Google client secret, SMTP credentials, or
# backend-only feature flags in Vercel.

NEXT_PUBLIC_API_BASE_URL=https://pfe-maintenaceindustrielle.onrender.com
