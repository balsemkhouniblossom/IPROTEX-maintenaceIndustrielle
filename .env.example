# GMAO Environment Configuration Template
# Use this template for .env.local (local dev) and .env.production (production).
# Optional future profile: .env.staging

# Application
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/GMAO_IPROTEX?retryWrites=true&w=majority
MONGODB_ROOT_USER=
MONGODB_ROOT_PASSWORD=
MONGODB_DATABASE=GMAO_IPROTEX
MONGODB_PORT=27017

# Redis
REDIS_URL=redis://:changeme@redis:6379
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# JWT
JWT_SECRET=replace-with-strong-random-secret
JWT_REFRESH_SECRET=replace-with-strong-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_VERIFICATION_SECRET=replace-with-strong-random-email-verification-secret

# Feature flags for phased rollout
ENABLE_LEGACY_EMAIL_TOKENS=true
ENABLE_EVENT_BASED_EMAILS=false
# In production, defaults to async dispatch to keep forgot-password responses fast
FORGOT_PASSWORD_ASYNC_EMAIL=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-frontend.vercel.app,https://your-frontend-*.vercel.app
# Audit Retention (days)
AUDIT_RETENTION_DAYS_INFO=30
AUDIT_RETENTION_DAYS_WARNING=60
AUDIT_RETENTION_DAYS_SECURITY=180
AUDIT_RETENTION_DAYS_CRITICAL=365

# Nginx
NGINX_PORT=80
NGINX_SSL_PORT=443

# Email / SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_PASS_EXISTS=true
SMTP_REJECT_UNAUTHORIZED=true
EMAIL_FROM="Iprotex <noreply@your-domain.com>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_FALLBACK_COOLDOWN_MS=300000

# Optional SMTP fallback via Brevo HTTP API (recommended when SMTP egress is blocked/timeouts)
BREVO_API_KEY=your-brevo-api-key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_API_TIMEOUT_MS=10000
API_URL=https://your-backend.example.com
APP_URL=https://your-frontend.example.com
FRONTEND_BASE_URL=https://your-frontend.example.com
BACKEND_URL=https://your-backend.example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend.example.com/auth/google/callback
NEXT_PUBLIC_API_BASE_URL=https://your-backend.example.com
DEFAULT_LOCALE=en

# Optional: S3 or other cloud storage for uploads
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_BUCKET_NAME=your_bucket
# AWS_REGION=us-east-1
