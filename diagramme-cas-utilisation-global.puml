@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #334155
}

title Diagramme global des cas d'utilisation - GMAO industrielle

actor "Visiteur" as Visitor
actor "Utilisateur authentifie" as User
actor "Administrateur" as Admin
actor "Operateur" as Operator
actor "Technicien" as Technician
actor "Equipement IoT / Machine" as DeviceActor
actor "Service de messagerie" as Messaging
actor "Stockage fichiers" as FileStorage
actor "Module IA" as AI
actor "Planificateur automatique" as Scheduler
actor "Passerelle temps reel" as RealtimeGateway

User <|-- Admin
User <|-- Operator
User <|-- Technician

rectangle "Systeme GMAO" {

  package "Authentification et comptes" {
    usecase "S'inscrire" as UC_Register
    usecase "Verifier email" as UC_VerifyEmail
    usecase "Se connecter" as UC_Login
    usecase "Se connecter avec Google" as UC_GoogleLogin
    usecase "Echanger resultat Google" as UC_GoogleExchange
    usecase "Completer profil" as UC_CompleteProfile
    usecase "Rafraichir session" as UC_Refresh
    usecase "Se deconnecter" as UC_Logout
    usecase "Mot de passe oublie" as UC_ForgotPassword
