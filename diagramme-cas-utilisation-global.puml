@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  ArrowColor #334155
}

title Diagramme global des cas d'utilisation - GMAO industrielle

actor "Visiteur" as Visitor
actor "Utilisateur authentifie" as User
actor "Administrateur" as Admin
actor "Operateur" as Operator
actor "Technicien" as Technician
actor "Machine" as MachineActor
actor "Service de messagerie" as Messaging
actor "Module IA (assistant correctif)" as AI
actor "Planificateur automatique" as Scheduler

User <|-- Admin
User <|-- Operator
User <|-- Technician

rectangle "Systeme GMAO" {

  package "Authentification et comptes" {
    usecase "S'inscrire" as UC_Register
    usecase "Verifier email" as UC_VerifyEmail
    usecase "Se connecter" as UC_Login
    usecase "Se connecter avec Google" as UC_GoogleLogin
    usecase "Rafraichir session" as UC_Refresh
    usecase "Se deconnecter" as UC_Logout
    usecase "Mot de passe oublie" as UC_ForgotPassword
    usecase "Reinitialiser mot de passe" as UC_ResetPassword
    usecase "Gerer son profil" as UC_Profile
  }

  package "Administration" {
    usecase "Gerer utilisateurs" as UC_ManageUsers
    usecase "Gerer machines" as UC_ManageMachines
    usecase "Gerer types de machines" as UC_ManageMachineTypes
    usecase "Gerer modules" as UC_ManageModules
    usecase "Gerer types de modules" as UC_ManageModuleTypes
    usecase "Gerer plans de maintenance" as UC_ManagePlans
    usecase "Gerer checklist preventive" as UC_ManagePreventiveTasks
    usecase "Synchroniser checklist depuis plans" as UC_SyncChecklist
  }

  package "Interventions et ordres de travail" {
    usecase "Gerer ordres de travail" as UC_ManageWO
    usecase "Creer ordre de travail" as UC_CreateWO
    usecase "Mettre a jour ordre de travail" as UC_UpdateWO
    usecase "Valider ordre de travail" as UC_ValidateWO
    usecase "Consulter rapports d'intervention" as UC_ViewReports
  }

  package "Maintenance preventive" {
    usecase "Traiter maintenance preventive" as UC_PreventiveFlow
    usecase "Planifier premiere occurrence" as UC_ScheduleFirst
    usecase "Executer occurrence preventive" as UC_ExecutePreventive
    usecase "Soumettre intervention preventive" as UC_SubmitPreventive
    usecase "Valider intervention preventive" as UC_ApprovePreventive
    usecase "Replanifier occurrence preventive" as UC_ReschedulePreventive
    usecase "Generer prochaine echeance automatiquement" as UC_GenerateNextDue
    usecase "Consulter etat preventif machine" as UC_PreventiveState
  }

  package "Maintenance corrective" {
    usecase "Traiter maintenance corrective" as UC_CorrectiveFlow
    usecase "Signaler panne et creer OT corrective" as UC_ReportFault
    usecase "Executer intervention corrective" as UC_ExecuteCorrective
    usecase "Valider intervention corrective" as UC_ApproveCorrective
    usecase "Demander pieces" as UC_RequestParts
    usecase "Decider demande pieces" as UC_DecideParts
    usecase "Consommer pieces et decrementer stock" as UC_ConsumeStock
    usecase "Consulter assistant correctif" as UC_CorrectiveAssistant
    usecase "Proposer solutions de panne" as UC_ProposeFaultSolutions
  }

  package "Stocks et catalogue" {
    usecase "Gerer stock" as UC_ManageStock
    usecase "Gerer catalogue des pieces" as UC_ManageCatalog
    usecase "Gerer pieces liees aux OT" as UC_ManageOtPieces
    usecase "Gerer lubrifiants" as UC_ManageLubricants
    usecase "Gerer journaux de lubrification" as UC_ManageLubLogs
  }

  package "Documents" {
    usecase "Gerer documents techniques" as UC_ManageDocuments
    usecase "Televerser document" as UC_UploadDocument
    usecase "Consulter document" as UC_ViewDocument
    usecase "Consulter manuels machine" as UC_ViewManuals
  }

  package "Notifications et messagerie" {
    usecase "Consulter notifications" as UC_ViewNotifications
    usecase "Marquer notifications comme lues" as UC_ReadNotifications
    usecase "Generer notifications automatiques" as UC_AutoNotifications
    usecase "Envoyer emails transactionnels" as UC_SendEmails
  }

  package "Capteurs et KPI" {
    usecase "Gerer capteurs" as UC_ManageSensors
    usecase "Gerer mesures" as UC_ManageMeasures
    usecase "Collecter mesures machine" as UC_CollectMeasures
    usecase "Surveiller alertes capteurs" as UC_SensorAlerts
    usecase "Consulter KPI" as UC_ViewKPI
    usecase "Mettre a jour KPI automatiquement" as UC_RefreshKPI
  }
}

Visitor --> UC_Register
Visitor --> UC_Login
Visitor --> UC_GoogleLogin
Visitor --> UC_VerifyEmail
Visitor --> UC_ForgotPassword
Visitor --> UC_ResetPassword

User --> UC_Refresh
User --> UC_Logout
User --> UC_Profile

Admin --> UC_ManageUsers
Admin --> UC_ManageMachines
Admin --> UC_ManageMachineTypes
Admin --> UC_ManageModules
Admin --> UC_ManageModuleTypes
Admin --> UC_ManagePlans
Admin --> UC_ManagePreventiveTasks
Admin --> UC_ManageWO
Admin --> UC_ValidateWO
Admin --> UC_ViewReports
Admin --> UC_ManageStock
Admin --> UC_ManageCatalog
Admin --> UC_ManageOtPieces
Admin --> UC_ManageLubricants
Admin --> UC_ManageLubLogs
Admin --> UC_ManageDocuments
Admin --> UC_ViewKPI
Admin --> UC_ManageSensors
Admin --> UC_ManageMeasures
Admin --> UC_CorrectiveAssistant
Admin --> UC_ViewNotifications

Operator --> UC_PreventiveFlow
Operator --> UC_CorrectiveFlow
Operator --> UC_PreventiveState
Operator --> UC_ViewManuals
Operator --> UC_ViewNotifications
Operator --> UC_ViewKPI

Technician --> UC_ApprovePreventive
Technician --> UC_ExecuteCorrective
Technician --> UC_ApproveCorrective
Technician --> UC_DecideParts
Technician --> UC_ConsumeStock
Technician --> UC_ViewManuals
Technician --> UC_ViewReports
Technician --> UC_ViewNotifications

MachineActor --> UC_CollectMeasures
Messaging --> UC_SendEmails
AI --> UC_ProposeFaultSolutions
Scheduler --> UC_GenerateNextDue
Scheduler --> UC_AutoNotifications
Scheduler --> UC_SensorAlerts
Scheduler --> UC_RefreshKPI

UC_ManageWO ..> UC_CreateWO : <<include>>
UC_ManageWO ..> UC_UpdateWO : <<include>>
UC_ManageWO ..> UC_ValidateWO : <<include>>

UC_ManagePreventiveTasks ..> UC_SyncChecklist : <<extend>>

UC_PreventiveFlow ..> UC_ScheduleFirst : <<include>>
UC_PreventiveFlow ..> UC_ExecutePreventive : <<include>>
UC_PreventiveFlow ..> UC_SubmitPreventive : <<include>>
UC_PreventiveFlow ..> UC_ApprovePreventive : <<include>>
UC_PreventiveFlow ..> UC_PreventiveState : <<include>>
UC_ApprovePreventive ..> UC_GenerateNextDue : <<include>>
UC_ReschedulePreventive ..> UC_ScheduleFirst : <<extend>>

UC_CorrectiveFlow ..> UC_ReportFault : <<include>>
UC_CorrectiveFlow ..> UC_ExecuteCorrective : <<include>>
UC_CorrectiveFlow ..> UC_ApproveCorrective : <<include>>
UC_CorrectiveFlow ..> UC_RequestParts : <<extend>>
UC_DecideParts ..> UC_ConsumeStock : <<include>>
UC_CorrectiveAssistant ..> UC_ProposeFaultSolutions : <<include>>

UC_ManageDocuments ..> UC_UploadDocument : <<include>>
UC_ViewManuals ..> UC_ViewDocument : <<include>>

UC_AutoNotifications ..> UC_SendEmails : <<extend>>
UC_ViewNotifications ..> UC_ReadNotifications : <<extend>>

UC_ManageMeasures ..> UC_CollectMeasures : <<include>>
UC_SensorAlerts ..> UC_CollectMeasures : <<include>>
UC_RefreshKPI ..> UC_ViewKPI : <<extend>>

note right of UC_PreventiveFlow
Flux preventif implemente:
1) planification de la premiere occurrence
2) execution/soumission par l'operateur
3) validation par technicien/admin
4) generation automatique de la prochaine echeance
end note

note right of UC_CorrectiveFlow
Flux correctif implemente:
signalement panne, intervention,
validation, pieces et impact stock.
end note

@enduml
