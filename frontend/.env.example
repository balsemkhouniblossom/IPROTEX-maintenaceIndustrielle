# Frontend environment configuration template
# Copy this to .env.local for local development or configure as Vercel environment variables.

# Backend API base URL used by frontend service layer
NEXT_PUBLIC_API_BASE_URL=https://pfe-maintenaceindustrielle.onrender.com

# Supabase project origin used by signed/public avatar image URLs
NEXT_PUBLIC_SUPABASE_URL=https://<supabase-project-ref>.supabase.co

# Do not add SUPABASE_SECRET_KEY or other Supabase server-side storage secrets here.

# Frontend error tracking (see src/instrumentation*.ts, sentry.*.config.ts).
# Optional — Sentry stays fully uninitialized (safe no-op) until a real DSN
# is set here. A Sentry DSN is not a secret (write-only, publishable by
# design), which is why it's safe as a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
