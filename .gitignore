# =====================
# DEPENDENCIES
# =====================
node_modules
**/node_modules

# =====================
# FRONTEND (Next.js)
# =====================
.next
out
.vercel

# =====================
# BACKEND (NestJS)
# =====================
dist
build
backend/uploads/
backend/quarantine/
backend/logs/
backend/tmp/
backend/temp/

# =====================
# TESTS
# =====================
coverage
.nyc_output

# =====================
# ENV FILES (VERY IMPORTANT)
# =====================
.env
.env.*
!.env.example
.env.example
backend/.env.example

# =====================
# LOCAL BACKUPS (VERY IMPORTANT)
# Manual code/filesystem/MongoDB backup archives — these can contain raw
# database dumps (including the users collection: bcrypt password hashes,
# refresh token hashes) and must never be committed. Untracked on
# 2026-08-01 after backups/mongodb/*/GMAO_IPROTEX/users.bson was found
# checked in; kept on local disk, only removed from Git tracking.
# =====================
/backups
# =====================
# LOGS
# =====================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =====================
# OS
# =====================
.DS_Store

# =====================
# IDE
# =====================
.vscode
.idea

# =====================
# TYPESCRIPT
# =====================
*.tsbuildinfo

# =====================
# PYTHON / AI SERVICE
# =====================
ai-service/.venv/
ai-service/**/__pycache__/
ai-service/**/.ipynb_checkpoints/
ai-service/data/raw/*
!ai-service/data/raw/.gitkeep
ai-service/data/processed/*
!ai-service/data/processed/.gitkeep
ai-service/artifacts/*
!ai-service/artifacts/.gitkeep

# =====================
# GENERATED LINT / DEBUG / PREVIEW ARTIFACTS (do not commit)
# ESLint run-output dumps (stdout/stderr/JSON reports/crash logs), temporary
# config snapshots, and local PDF render-preview check artifacts. Scoped so
# legitimate docs/PDFs (e.g. resources/*.pdf maintenance plans) and source
# config files remain tracked.
# =====================
backend/lint-*.txt
backend/lint-*.json
backend/eslint-*.txt
backend/temp-eslint-config.*
backend/preview-*.pdf
frontend/test-results/
